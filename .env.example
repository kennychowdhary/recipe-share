# Copy to .env.local and fill in.

# Supabase → Project Settings → API.
# NEXT_PUBLIC_ means these ship to the browser — that's intended and safe here,
# because row-level security limits the anon key to reading and inserting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used only by the /api/parse-recipe route, which runs on the server.
# Never add a NEXT_PUBLIC_ prefix to these — that would publish the key
# in the browser bundle where anyone could read and spend it.
ANTHROPIC_API_KEY=
# Optional. Set for a gateway; omit to use api.anthropic.com directly.
ANTHROPIC_BASE_URL=
# Optional. Gateways namespace model IDs (e.g. azure/anthropic/claude-opus-5).
# Omit to use claude-opus-5.
ANTHROPIC_MODEL=
